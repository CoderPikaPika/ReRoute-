{
  "name": "sih-freight-logistics-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented SIH freight and logistics platform prototype",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=@sih-freight/backend\" \"npm run dev --workspace=@sih-freight/frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.43.0"
  },
  "engines": {
    "node": "24.14.1",
    "npm": ">=11.0.0"
  }
}
