NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/sih_freight_platform

# Use a unique secret with at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-local-development-secret
JWT_ACCESS_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Reserved for later map-provider integration. Leave empty for Phase 1.
MAP_API_KEY=

# Local Python XGBoost forecasting service.
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional live maritime providers. Keep these values server-side only.
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
AISSTREAM_API_KEY=
# JSON example: [[[ -45, 30 ], [ 25, 125 ]]] where each point is [latitude, longitude].
AISSTREAM_BOUNDING_BOXES=[[[18,60],[30,100]]]
# Optional comma-separated MMSI watchlist; maximum is provider-defined.
AISSTREAM_MMSI_FILTER=
