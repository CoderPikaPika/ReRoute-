NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/sih_freight_platform

# Use a unique secret with at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-local-development-secret
JWT_ACCESS_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Reserved for later map-provider integration. Leave empty for Phase 1.
MAP_API_KEY=

# Local Python XGBoost forecasting service.
ML_SERVICE_URL=http://127.0.0.1:8000
